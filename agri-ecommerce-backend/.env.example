DB_HOST=localhost
DB_PORT=3306
DB_NAME=veggie_main
DB_URL=jdbc:mysql://localhost:3306/veggie_main?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_database_password

JWT_SECRET=AgriEcommerceJwtSecretKeyForLocalDevelopmentMustBeAtLeast32Chars2026
JWT_EXPIRATION_MS=86400000

APP_PUBLIC_BASE_URL=http://localhost:3000
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# ===== Email Configuration =====
# Providers: smtp, google-script, resend.
# Demo production recommendation: google-script. Long-term production recommendation: resend with a verified domain.
EMAIL_PROVIDER=smtp
MAIL_FROM=AgriMarket <no-reply@example.com>
MAIL_FROM_NAME=AgriMarket
MAIL_REPLY_TO=agrimarket.ecommerce@gmail.com

# Google Apps Script HTTPS relay. Sends from the Gmail account that owns/deploys the Apps Script.
GOOGLE_SCRIPT_MAIL_URL=https://script.google.com/macros/s/your_deployment_id/exec
GOOGLE_SCRIPT_MAIL_SECRET=replace_with_a_long_random_secret

RESEND_API_KEY=your_resend_api_key_here
RESEND_API_URL=https://api.resend.com/emails

VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=your_sandbox_tmn_code
VNPAY_HASH_SECRET=your_sandbox_hash_secret
VNPAY_RETURN_URL=http://localhost:3000/checkout/vnpay-return
VNPAY_EXPIRE_MINUTES=15

# ===== Shipping Carrier Configuration =====
GHN_API_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
GHN_TOKEN=your_ghn_token_here
GHN_SHOP_ID=your_ghn_shop_id_here

# ===== AI Chatbot Configuration =====
# Bật/tắt tính năng AI chatbot (mặc định false để an toàn)
AI_CHATBOT_ENABLED=false

# Provider: "gemini" hoặc "openai"
AI_PROVIDER=gemini

# Tên model (gemini-1.5-flash, gemini-1.5-pro, gpt-4o-mini, gpt-4o, ...)
AI_MODEL=gemini-flash-latest

# API Keys — điền key thật vào đây, KHÔNG commit file .env thật
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Số sản phẩm tối đa đưa vào prompt context
AI_MAX_PRODUCTS_CONTEXT=10

# Timeout gọi LLM tính bằng giây
AI_TIMEOUT_SECONDS=20
